    <h1>WELCOME BACK <%= user.first_name %></h1>
    <a href="/log-out">LOG OUT</a>
  <% } else { %>
    <h1>please log in</h1>
    <a href="/log-in">Log In</a>
  <%}%>
  </body>
</html>
