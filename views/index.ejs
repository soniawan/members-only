<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Homepage</title>
  </head>
  <body>
    <nav>
      <ul>
        <% if (!locals.user) {%>
          <li><a href="/log-in">Login</a></li>
          <li><a href="/sign-up">Signup</a></li>
        <% } else { %>
          <% if (!user.is_member) { %>
            <li><a href="/membership">Join a club!</a></li>
          <% } %>
          <li><a href="/log-out">Logout</a></li>
        <% } %>
      </ul>
    </nav>

    <% if (locals.user) {%>
    <h1>WELCOME BACK <%= user.first_name %></h1>

    <a href="/messages">Create a message</a>

    <div>
      <% if (!locals.messages) { %>
        <p>No messages yet</p>
      <% } else { %>
        <% for (const message of locals.messages) { %>
          <div>
            <h2><%= message.title %></h2>
            <p><%= message.text %></p>
            <% if (user.is_member) { %>
              <p>by <span style="text-transform: capitalize;"><%= message.first_name %> <%= message.last_name %></span></p>
            <% } %>
            <% if (message.user_id == user.id || user.is_admin) { %>
              <form action="/messages/<%= message.id %>" method="post">
                <button type="submit">Delete</button>
              </form>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>
  <% } else { %>
    <h1>Hai Guest</h1>

    <div>
      <% if (!locals.messages) { %>
        <p>No messages yet</p>
      <% } else { %>
        <% locals.messages.forEach(message => { %>
          <div>
            <h2><%= message.title %></h2>
            <p><%= message.text %></p>
          </div>
        <% }); %>
      <% } %>
    </div>
  <%}%>
  </body>
</html>
