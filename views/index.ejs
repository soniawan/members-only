<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Homepage</title>
  </head>
  <body>
    <nav>
      <ul>
        <li><a href="/log-in">Login</a></li>
        <li><a href="/sign-up">Signup</a></li>
        <% if (locals.user) {%>
        <li><a href="/log-out">Logout</a></li>
